// Par o impar. Pide un número entero y muestra si es par o impar. 
Proceso Ejercicio3
	Definir num como Entero;
	Escribir "Introduce un número entero:";
	Leer num;
	
	Si num % 2 = 0 Entonces
		Escribir "El número introducido es par.";
	SiNo
		Escribir "El número introducido es impar.";
	FinSi
FinProceso
